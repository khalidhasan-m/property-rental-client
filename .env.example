# Public URL of the Express API, including the /api/v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Stripe publishable key used by the browser checkout. Leave blank if payments are disabled locally.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Google OAuth web client ID. Leave blank to hide Google sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace_with_google_oauth_web_client_id
